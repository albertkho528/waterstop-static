---
import SectionHead from "./SectionHead.astro";
import { waLink, waExt } from "../data/store";
import type { Content } from "../i18n";
interface Props { c: Content }
const { t } = Astro.props.c;
const A = t.audience;
const links = [
  { href: "#cari" },
  { href: "#produk" },
  { href: waLink(t.wa.contractor), ...waExt() },
  { href: waLink(t.wa.developer), ...waExt() },
];
---
<section class="sec" id="siapa">
  <div class="wrap">
    <SectionHead layerWord={t.layer} layer="07" label={A.label} h2={A.h2} lead={A.lead} />
    <div class="aud tilt-wrap">
      {A.items.map(([title, text, cta], i) => (
        <div class="tilt"><h3>{title}</h3><p>{text}</p><a class="go" {...links[i]}>{cta}</a></div>
      ))}
    </div>
  </div>
</section>
