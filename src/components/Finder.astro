---
import SectionHead from "./SectionHead.astro";
import { areaResult, pad2 } from "../lib/templates";
import type { Content } from "../i18n";
interface Props { c: Content }
const { t, areas, products } = Astro.props.c;
const F = t.finder;
---
<section class="sec" id="cari">
  <div class="wrap">
    <SectionHead layerWord={t.layer} layer="03" label={F.label} h2={F.h2} lead={F.lead} />
    <div class="area-chips" role="group" aria-label={F.chipsAria} id="areas">
      {areas.map((a, i) => (
        <button class="chipbtn" type="button" data-id={a.id} aria-pressed={i === 0 ? "true" : "false"}><i>{pad2(i + 1)}</i>{a.name}</button>
      ))}
    </div>
    <div class="finder">
      <div class="vp" id="houseStage" aria-label={F.stageAria}>
        <canvas id="houseGL" aria-hidden="true"></canvas>
        <div class="hotspots" id="hotspots">
          {areas.map((a, i) => (
            <button class="hs" type="button" data-id={a.id} aria-label={a.title} style="visibility:hidden">{i + 1}<span>{a.name}</span></button>
          ))}
        </div>
        <div class="hud tl">{F.hudTl}</div>
        <div class="hud br">{F.hudBr}</div>
      </div>
      <div class="result" id="result" aria-live="polite" set:html={areaResult(areas[0], t, products)} />
    </div>
  </div>
</section>
