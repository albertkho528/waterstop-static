---
import { STORE, waExt, waLink } from "../data/store";
import type { Content } from "../i18n";
interface Props {
  c: Content;
}
const { t } = Astro.props.c;
const C = t.contact;
---

<section class="contact" id="kontak">
  <div class="wrap">
    <div class="contact-copy">
      <div class="eyebrow">
        <b>{C.eyebrow[0]}</b> {C.eyebrow[1]}
      </div>
      <h2>
        {C.h2[0]}
        <span>{C.h2[1]}</span>
      </h2>
      <p>{C.lead}</p>
      <div class="cta-row">
        <a class="btn primary" href={waLink(t.wa.default)} {...waExt()}>
          {t.hero.ctaWa}
        </a>
        <a class="btn" href={STORE.maps} target="_blank" rel="noopener">
          {C.directions}
        </a>
      </div>
      <figure class="store">
        <img
          src="/proyek/toko.webp"
          alt={`${C.store} · Waterstop Mapei Bondall`}
          loading="lazy"
          decoding="async"
          width="960"
          height="720"
        />
        <figcaption>{C.store}</figcaption>
      </figure>
    </div>
    <dl class="card">
      <div class="crow">
        <dt>{C.phone}</dt>
        <dd>
          <span id="c-wa">{STORE.phoneDisplay}</span>
          <button class="copy" data-copy="c-wa" type="button">
            {C.copy}
          </button>
        </dd>
      </div>
      <div class="crow">
        <dt>{C.address}</dt>
        <dd>
          <span id="c-addr">{STORE.address}</span>
          <button class="copy" data-copy="c-addr" type="button">
            {C.copy}
          </button>
        </dd>
      </div>
      <div class="crow">
        <dt>{C.hours}</dt>
        <dd>{C.hoursValue}</dd>
      </div>
      <div class="crow">
        <dt>{C.google}</dt>
        <dd>{C.ratingShort}</dd>
      </div>
      <div class="crow">
        <dt>{C.brands}</dt>
        <dd>Mapei · Bondall</dd>
      </div>
    </dl>
  </div>
</section>

<footer class="foot">
  <div class="wrap">
    <span>
      © {new Date().getFullYear()} {STORE.name} · {STORE.company} ·{" "}
      {t.footer.area}
    </span>
    <span>{t.footer.tm}</span>
  </div>
</footer>

<a class="btn primary fab" href={waLink(t.wa.default)} {...waExt()}>
  WhatsApp
</a>
