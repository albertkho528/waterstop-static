---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

import bak from "../assets/images/proyek/bak.webp";
import balkon from "../assets/images/proyek/balkon.webp";
import dak from "../assets/images/proyek/dak.webp";
import floorDrain from "../assets/images/proyek/floor-drain.webp";
import kamarMandi from "../assets/images/proyek/kamar-mandi.webp";
import { STORE } from "../data/store";
import type { Content } from "../i18n";
import SectionHead from "./SectionHead.astro";
interface Props {
  c: Content;
}
const { t } = Astro.props.c;
const P = t.projects;
// Project photos in src/assets/images/proyek/, in the same order as the `projects.tiles` text in the language file.
const IMAGES: (ImageMetadata | undefined)[] = [
  balkon,
  kamarMandi,
  dak,
  bak,
  floorDrain,
];
const gallery = STORE.instagram || STORE.facebook;
const socials = [
  ["Facebook", STORE.facebook],
  ["Instagram", STORE.instagram],
  ["TikTok", STORE.tiktok],
].filter(([, u]) => u);
---

<section class="sec" id="proyek">
  <div class="wrap">
    <SectionHead
      layerWord={t.layer}
      layer="06"
      label={P.label}
      h2={P.h2}
      lead={P.lead}
    />
    <div class="proj-grid">
      {P.tiles.map(([title, text], i) => {
        const img = IMAGES[i];
        const sizes =
          i === 0
            ? "(max-width: 800px) 100vw, (max-width: 1280px) 50vw, 620px"
            : "(max-width: 800px) 50vw, (max-width: 1280px) 25vw, 310px";
        return (
          <a
            class="ph"
            href={gallery || "#kontak"}
            target={gallery ? "_blank" : undefined}
            rel={gallery ? "noopener" : undefined}
          >
            {img ? (
              <Picture
                src={img}
                alt={`${title}: ${text} · Waterstop Batam`}
                widths={[320, 480, 640, 960]}
                sizes={sizes}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
              />
            ) : (
              <span class="slot">{P.slot}</span>
            )}
            <b>{title}</b>
            <span>{text}</span>
          </a>
        );
      })}
    </div>
    <div class="socials">
      {socials.map(([label, url]) => (
        <a class="btn sm" href={url} target="_blank" rel="noopener">
          {label}
        </a>
      ))}
    </div>
  </div>
</section>
