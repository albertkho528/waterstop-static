---
import SectionHead from "./SectionHead.astro";
import { STORE } from "../data/store";
import type { Content } from "../i18n";
interface Props { c: Content }
const { t } = Astro.props.c;
const P = t.projects;
// Foto proyek: taruh file di /public/proyek/ lalu isi path-nya di sini, urut sesuai ubin
// (dak, kamar mandi, kolam, tandon, dinding). Contoh: "/proyek/dak-1.jpg". Kosong = kotak placeholder.
const IMAGES: (string | undefined)[] = [undefined, undefined, undefined, undefined, undefined];
const gallery = STORE.instagram || STORE.facebook;
const socials = [["Facebook", STORE.facebook], ["Instagram", STORE.instagram], ["TikTok", STORE.tiktok]].filter(([, u]) => u);
---
<section class="sec" id="proyek">
  <div class="wrap">
    <SectionHead layerWord={t.layer} layer="06" label={P.label} h2={P.h2} lead={P.lead} />
    <div class="proj-grid">
      {P.tiles.map(([title, text], i) => {
        const img = IMAGES[i];
        return (
          <a class="ph" href={gallery || "#kontak"} target={gallery ? "_blank" : undefined} rel={gallery ? "noopener" : undefined}
             style={img ? `background-image:linear-gradient(180deg,transparent 30%,rgba(0,0,0,.75)),url(${img});background-size:cover;background-position:center` : undefined}>
            {!img && <span class="slot">{P.slot}</span>}
            <b>{title}</b><span>{text}</span>
          </a>
        );
      })}
    </div>
    <div class="socials">
      {socials.map(([label, url]) => <a class="btn sm" href={url} target="_blank" rel="noopener">{label}</a>)}
    </div>
  </div>
</section>
