---
import type { Content } from "../i18n";
import SectionHead from "./SectionHead.astro";
interface Props {
  c: Content;
}
const { t } = Astro.props.c;
const P = t.problems;
const arrows = [
  "M17 4v24M8 19l9 9 9-9",
  "M4 17h24M19 8l9 9-9 9",
  "M17 6v22M10 21l7 7 7-7M6 6h22",
  "M17 30V6M8 15l9-9 9 9",
];
---

<section class="sec" id="masalah">
  <div class="wrap">
    <SectionHead
      layerWord={t.layer}
      layer="01"
      label={P.label}
      h2={P.h2}
      lead={P.lead}
    />
    <div class="problems tilt-wrap">
      {P.items.map(([tag, title, text], i) => (
        <div class="prob tilt">
          <svg
            class="arrow"
            viewBox="0 0 34 34"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <path d={arrows[i]} />
          </svg>
          <span class="tag">{tag}</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
