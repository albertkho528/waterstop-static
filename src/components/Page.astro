---
// The whole page for one language. Used by src/pages/index.astro, en/index.astro, zh/index.astro.
import { content, type Lang } from "../i18n";
import Base from "../layouts/Base.astro";
import Audience from "./Audience.astro";
import BuildStory from "./BuildStory.astro";
import Contact from "./Contact.astro";
import Faq from "./Faq.astro";
import Finder from "./Finder.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Problems from "./Problems.astro";
import Products from "./Products.astro";
import Projects from "./Projects.astro";
import Services from "./Services.astro";

interface Props {
  lang: Lang;
}
const c = content(Astro.props.lang);
// Data needed by the browser script (search result text, product details, 3D labels).
const clientData = {
  lang: c.lang,
  products: c.products,
  areas: c.areas,
  steps: c.steps,
  t: {
    htmlLang: c.t.htmlLang,
    layers: c.t.layers,
    wa: c.t.wa,
    finder: c.t.finder,
    products: c.t.products,
    build: { status: c.t.build.status },
    contact: { copy: c.t.contact.copy, copied: c.t.contact.copied },
  },
};
---

<Base lang={c.lang}>
  <Header c={c} />
  <main id="top">
    <Hero c={c} />
    <Problems c={c} />
    <BuildStory c={c} />
    <Finder c={c} />
    <Products c={c} />
    <Services c={c} />
    <Projects c={c} />
    <Audience c={c} />
    <Faq c={c} />
  </main>
  <Contact c={c} />
  <script
    type="application/json"
    id="i18n-data"
    set:html={JSON.stringify(clientData)}
  />
</Base>

<script>
  import "../scripts/main";
</script>
